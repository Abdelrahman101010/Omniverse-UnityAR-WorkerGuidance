# Python
__pycache__/
*.pyc
.venv/
.env

# VS Code
.vscode/.ropeproject/

# Build and temp
bin/
obj/
*.log
*.tmp
*.cache/

# Unity generated
client-unity/Library/
client-unity/Logs/
client-unity/Temp/
client-unity/Obj/
client-unity/UserSettings/
client-unity/Build/
# ─── Unity additional ignores ──────────────────────────────────
client-unity/.utmp/
client-unity/.vs/
client-unity/.vsconfig
# Auto-generated by Unity each time the editor opens — never commit
client-unity/*.csproj
client-unity/*.sln
client-unity/*.user
# Built APKs (use CI / release artifacts instead)
client-unity/*.apk
client-unity/*.aab
# Burst compiler debug info
client-unity/*_BurstDebugInformation_DoNotShip/
client-unity/*_BackUpThisFolder_ButDontShipItWithYourGame/
# Vuforia runtime cache
client-unity/QCAR/
# Duplicate of Packages/com.ptc.vuforia.engine-11.4.4.tgz — Vuforia's
# AddVuforiaEnginePackage.cs uses the Packages/ copy; the Editor/Migration
# copy is a leftover and should not ship in git.
client-unity/Assets/Editor/Migration/com.ptc.vuforia.engine-11.4.4.tgz
client-unity/Assets/Editor/Migration/com.ptc.vuforia.engine-11.4.4.tgz.meta
# Server runtime state — recreated on each run, not source
server-kit/runtime/sessions.json
server-kit/runtime/export-jobs.json
# Generated/exported sample assets — ignore everything inside, keep the folder itself
shared/samples/assets/*
!shared/samples/assets/.gitkeep
# OS
.DS_Store
Thumbs.db


# test-server
test-server/
